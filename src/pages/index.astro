---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import TagList from '../components/TagList.astro';
import Badge from '../components/Badge.astro';
import WorkRow from '../components/WorkRow.astro';
import QiitaList from '../components/QiitaList.astro';
import Icon from '../components/Icon.astro';
import { links } from '../data/site';

const profileEntry = await getEntry('profile', 'main');
if (!profileEntry) {
  throw new Error('src/data/profile.yaml に main がありません');
}
const profile = profileEntry.data;

// ホームの「代表作」は、プロジェクトとツールのうち featured を持つものを番号順に並べる
const projects = await getCollection('projects');
const tools = await getCollection('tools');
const works = [
  ...projects
    .filter((entry) => entry.data.featured !== undefined)
    .map(({ data }) => ({
      order: data.featured ?? 0,
      href: `/portfolio.html#${data.anchor}`,
      meta: `Project · ${data.category}`,
      title: data.title,
      body: data.summary ?? '',
      tags: data.tags,
      image: data.diagram ? { src: data.diagram.image, alt: data.diagram.alt } : undefined,
    })),
  ...tools
    .filter((entry) => entry.data.featured !== undefined)
    .map(({ data }) => ({
      order: data.featured ?? 0,
      href: `/toolbox.html#${data.anchor}`,
      meta: ['Tool', data.category, data.release].filter(Boolean).join(' · '),
      title: data.title,
      body: data.summary,
      tags: data.tags,
      image: data.screenshots?.[0] ? { src: data.screenshots[0].image, alt: data.screenshots[0].alt } : undefined,
    })),
].sort((a, b) => a.order - b.order);
---

<BaseLayout page="home">
  <PageHero
    size="xl"
    intro
    eyebrow="$ whoami -> infra engineer"
    lead="Linux・ネットワーク・Python を中心に、公開／監視／自動化を実務と個人プロジェクトの両面で積み重ねています。手順の再現性と、あとから見返せる構成整理を意識して、経歴をドキュメントとしてまとめました。"
  >
    保守運用を<mark>土台</mark>に、構築・監視・自動化へ広げるインフラエンジニア
    <Fragment slot="after">
      <ul class="status" aria-label="現在の状況">
        {
          profile.status.map((item) => (
            <li class:list={['status-item', `status-item--${item.tone}`]}>
              <span class="status-dot" aria-hidden="true" />
              <span class="status-label">{item.label}</span>
              <span class="status-value">{item.value}</span>
            </li>
          ))
        }
      </ul>
      <div class="btn-row hero-actions">
        <a href="#works" class="btn btn--primary btn--lg">代表作を見る<Icon name="arrow-down" /></a>
        <a href={links.github} class="btn btn--lg" target="_blank" rel="noopener noreferrer">GitHub<Icon name="external" size={16} /></a>
        <a href={links.qiita} class="btn btn--lg" target="_blank" rel="noopener noreferrer">Qiita<Icon name="external" size={16} /></a>
      </div>
    </Fragment>
  </PageHero>

  <section class="section" aria-labelledby="strengths-title" id="overview">
    <SectionHeader label="Strengths" title="今の強み" titleId="strengths-title" />
    <div class="strengths">
      {
        profile.strengths.map((item) => (
          <article>
            <p class="strength-index mono">{item.index}</p>
            <h3>{item.title}</h3>
            <p class="strength-body">{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="works-title" id="works">
    <SectionHeader label="Works" title="代表作" titleId="works-title">
      <a href="/toolbox.html" class="text-link">作成ツールをすべて見る →</a>
    </SectionHeader>
    <ul class="works">
      {works.map((work) => <WorkRow {...work} />)}
    </ul>
  </section>

  <section class="section" aria-labelledby="career-title" id="career">
    <SectionHeader label="Career" title="経歴タイムライン" titleId="career-title" />
    <ol class="timeline" data-reveal-once>
      {
        profile.career.map((item, index) => (
          <li class:list={['timeline-item', { 'timeline-item--current': item.current }]} style={`--i: ${index}`}>
            <p class="timeline-period mono">
              {item.period}
              {item.current && <Badge tone="accent">NOW</Badge>}
            </p>
            <div class="timeline-text">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              <TagList tags={item.tags} />
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section" aria-labelledby="skills-title" id="skills">
    <SectionHeader label="Skills" title="主なスキル" titleId="skills-title" />
    <div class="skills">
      {
        profile.skills.map((skill) => (
          <article class="card skill">
            <div class="skill-head">
              <h3>{skill.title}</h3>
              <span class="mono">{skill.category}</span>
            </div>
            <p>{skill.body}</p>
            <TagList tags={skill.tags} />
          </article>
        ))
      }
    </div>
  </section>

  <section class="section" aria-labelledby="certifications-title" id="certifications">
    <SectionHeader label="Certifications" title="資格と現在地" titleId="certifications-title" />
    <ul class="certs">
      {
        profile.certifications.map((cert) => (
          <li>
            {cert.name}
            {cert.state === 'acquired' ? <Badge tone="ok">取得済</Badge> : <Badge tone="warn">学習中</Badge>}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section" aria-labelledby="publishing-title" id="publishing">
    <SectionHeader label="Publishing" title="発信・公開基盤" titleId="publishing-title">
      <a href={links.qiita} class="text-link" target="_blank" rel="noopener noreferrer">Qiitaプロフィール →</a>
    </SectionHeader>
    <div class="publishing">
      <article class="publish-main">
        <h3>Qiita 最新記事</h3>
        <p class="publish-text">構築手順や学習内容を短く整理して、あとから見返せる形で継続的に発信しています。</p>
        <QiitaList />
      </article>
      <div class="publish-side">
        <article class="card publish-card">
          <h3>GitHub</h3>
          <p class="publish-text">個人プロジェクトの構成や手順を、コードと合わせて確認できるように整理しています。</p>
          <div class="btn-row">
            <a href={links.github} class="btn btn--primary" target="_blank" rel="noopener noreferrer">GitHubを見る</a>
            <a href="/portfolio.html" class="btn">実績一覧</a>
          </div>
        </article>
        <article class="publish-card publish-card--dark">
          <p class="mono publish-kicker">How this site runs</p>
          <h3>Web 運用構成</h3>
          <p>このWebページは AWS S3 + CloudFront で配信し、問い合わせフォームは AWS Lambda Function URL と Amazon SES によるメール配信機能としてサーバレスで実装しています。</p>
          <p>GitHub Actions を使ったCI/CDも構築しており、main ブランチへの push をトリガーに S3 への自動デプロイと CloudFront のキャッシュ無効化までを自動化しています。</p>
          <TagList tags={['S3', 'CloudFront', 'Lambda', 'SES', 'GitHub Actions']} tone="dark" />
          <a href="/diagram.html#diagram-2" class="publish-dark-link">構成図を見る →</a>
        </article>
      </div>
    </div>
  </section>

  <section class="card contact-cta" aria-labelledby="contact-title">
    <div>
      <p class="label">Contact</p>
      <h2 id="contact-title">お気軽にご連絡ください</h2>
    </div>
    <a href="/contact.html" class="btn btn--primary btn--lg">問い合わせフォームへ<Icon name="arrow-right" /></a>
  </section>
</BaseLayout>

<script>
  // 経歴の線と点の演出は、画面に初めて入ったときに1回だけ再生する
  document.querySelectorAll<HTMLElement>('[data-reveal-once]').forEach((target) => {
    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          target.classList.add('is-revealed');
          observer.disconnect();
        }
      },
      { threshold: 0.2 },
    );
    observer.observe(target);
  });
</script>

<style>
  .status {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 32px;
    font-size: 14px;
  }

  .status-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
  }

  .status-item--live {
    --dot: var(--dot-live);
  }

  .status-item--progress {
    --dot: var(--dot-progress);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--dot, var(--dot-neutral));
  }

  .status-label {
    color: var(--ink-3);
  }

  .status-value {
    font-weight: 500;
  }

  @media (prefers-reduced-motion: no-preference) {
    .status-item--live .status-dot,
    .status-item--progress .status-dot {
      animation: status-ring 2.4s ease-out infinite;
    }

    .status-item--progress .status-dot {
      animation-delay: 1.2s;
    }

    /* 現職と学習中の点から波紋を広げ、今動いている状態であることを示す */
    @keyframes status-ring {
      from {
        box-shadow: 0 0 0 0 color-mix(in srgb, var(--dot) 45%, transparent);
      }
      to {
        box-shadow: 0 0 0 8px color-mix(in srgb, var(--dot) 0%, transparent);
      }
    }
  }

  .hero-actions {
    margin-top: 32px;
    gap: 12px;
  }

  .strengths {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 40px;
  }

  .strength-index {
    margin-bottom: 12px;
    font-size: 13px;
    color: var(--ink-3);
  }

  .strengths h3 {
    margin-bottom: 10px;
    font-size: 19px;
    line-height: 1.5;
  }

  .strength-body {
    font-size: 15px;
    color: var(--ink-2);
  }

  .works {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* 経歴は左に縦の線と点を置く。線は項目ごとに、自分の点から次の項目の点までを描く */
  .timeline {
    padding-left: 32px;
  }

  .timeline-item {
    --dot-top: 34px;
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 40px;
    padding: 19px 0 28px;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    top: calc(var(--dot-top) - 6px);
    left: -32px;
    z-index: 1;
    width: 12px;
    height: 12px;
    border: 2px solid var(--accent);
    border-radius: 50%;
    background: var(--ground);
  }

  .timeline-item--current::before {
    background: var(--accent);
  }

  .timeline-item:not(:last-child)::after {
    content: '';
    position: absolute;
    top: var(--dot-top);
    bottom: calc(var(--dot-top) * -1);
    left: -27px;
    width: 2px;
    background: var(--accent);
    opacity: 0.35;
    transform-origin: top;
  }

  /* 画面に初めて入ったときだけ、線が上から伸び、点が弾み、項目が順に浮かぶ。
     JS が動かない場合や動きを減らす設定では、最初から完成した状態で表示する */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .timeline:not(.is-revealed) .timeline-item::before {
      transform: scale(0);
    }

    :global(.js) .timeline:not(.is-revealed) .timeline-item::after {
      transform: scaleY(0);
    }

    :global(.js) .timeline:not(.is-revealed) .timeline-period,
    :global(.js) .timeline:not(.is-revealed) .timeline-text {
      opacity: 0;
    }

    .timeline.is-revealed .timeline-item::before {
      animation: timeline-pop 0.35s ease-out both;
      animation-delay: calc(var(--i) * 0.35s + 0.1s);
    }

    .timeline.is-revealed .timeline-item::after {
      animation: timeline-grow 0.45s ease-out both;
      animation-delay: calc(var(--i) * 0.35s + 0.3s);
    }

    .timeline.is-revealed .timeline-period,
    .timeline.is-revealed .timeline-text {
      animation: timeline-up 0.5s ease-out both;
      animation-delay: calc(var(--i) * 0.35s + 0.15s);
    }

    @keyframes timeline-pop {
      0% {
        transform: scale(0);
      }
      70% {
        transform: scale(1.3);
      }
    }

    @keyframes timeline-grow {
      from {
        transform: scaleY(0);
      }
    }

    @keyframes timeline-up {
      from {
        opacity: 0;
        transform: translateY(10px);
      }
    }
  }

  .timeline-period {
    display: flex;
    flex: 0 0 200px;
    align-items: center;
    gap: 10px;
    height: 30px;
    font-size: 13px;
    color: var(--ink-2);
  }

  .timeline-text {
    flex: 999 1 420px;
    min-width: 0;
    max-width: 680px;
  }

  .timeline-text h3 {
    margin-bottom: 6px;
    font-size: 19px;
    line-height: 1.5;
  }

  .timeline-text p {
    margin-bottom: 12px;
    font-size: 15px;
    color: var(--ink-2);
  }

  .skills {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 16px;
  }

  .skill {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
  }

  .skill-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
  }

  .skill-head h3 {
    font-size: 18px;
  }

  .skill-head span {
    font-size: 12px;
    color: var(--ink-3);
  }

  .skill p {
    flex: 1;
    font-size: 15px;
    color: var(--ink-2);
  }

  .certs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 0 32px;
  }

  .certs li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
  }

  .publishing {
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
  }

  .publish-main {
    flex: 999 1 420px;
    min-width: 0;
  }

  .publish-side {
    display: flex;
    flex: 1 1 320px;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
  }

  .publishing h3 {
    margin-bottom: 8px;
    font-size: 18px;
  }

  .publish-text {
    margin-bottom: 12px;
    font-size: 15px;
    color: var(--ink-2);
  }

  .publish-card {
    padding: 24px;
  }

  .publish-card--dark {
    border-radius: var(--radius-lg);
    background: var(--dark);
    color: var(--dark-ink);
  }

  .publish-card--dark h3 {
    color: #ffffff;
  }

  .publish-card--dark p {
    margin-bottom: 12px;
    font-size: 14px;
  }

  .publish-dark-link {
    display: inline-block;
    margin-top: 16px;
    font-size: 14px;
    font-weight: 500;
    color: #85b7eb;
  }

  .publish-dark-link:hover {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .publish-kicker {
    font-size: 12px;
    color: var(--dot-neutral);
  }

  .contact-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: var(--section-space);
    padding: clamp(28px, 5vw, 56px);
    border-radius: 24px;
  }

  .contact-cta h2 {
    font-size: clamp(22px, 2.6vw, 30px);
    line-height: 1.4;
  }
</style>
