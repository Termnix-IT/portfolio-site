---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import DetailArticle from '../components/DetailArticle.astro';
import TagList from '../components/TagList.astro';
import Badge from '../components/Badge.astro';
import ZoomableImage from '../components/ZoomableImage.astro';
import Icon from '../components/Icon.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const entries = await Promise.all(
  projects.map(async (project, index) => ({
    ...project.data,
    number: String(index + 1).padStart(2, '0'),
    Content: (await render(project)).Content,
  })),
);
---

<BaseLayout page="projects">
  <PageHero
    eyebrow="Portfolio"
    lead="オンプレネットワークの設計や監視基盤の整備など、運用視点を持って手を動かしたプロジェクトをまとめています。構成図と手順を残し、あとから見返せる形で公開しています。"
    tags={['Linux', 'Network', 'Monitoring', 'Python', 'Security']}
  >
    個人で<mark>構築・検証</mark>したプロジェクトの記録
  </PageHero>

  {
    entries.map((project) => (
      <DetailArticle id={project.anchor} label={`${project.number} · ${project.category}`} title={project.title}>
        <Fragment slot="meta">
          <p>
            <Badge tone="ok">{project.status}</Badge>
          </p>
          <TagList tags={project.tags} />
        </Fragment>
        <div class="prose">
          <project.Content />
        </div>
        <ul class="publications" aria-label="関連する公開物">
          {project.publications.map((item) => (
            <li class="card publication">
              <span class="publication-head">
                {item.href ? (
                  <a class="publication-label publication-link" href={item.href} target="_blank" rel="noopener noreferrer">
                    {item.label}
                    <Icon name="external" size={14} />
                  </a>
                ) : (
                  <span class="publication-label">{item.label}</span>
                )}
                <Badge tone={item.href ? 'ok' : 'warn'}>{item.status}</Badge>
              </span>
              <span class="publication-text">{item.description}</span>
            </li>
          ))}
        </ul>
        {project.screenshots && (
          <div class="figures">
            <h3 class="figure-title">画面</h3>
            {project.screenshots.map((shot) => (
              <ZoomableImage src={shot.image} alt={shot.alt} caption={shot.caption} />
            ))}
          </div>
        )}
        {project.diagram && (
          <div>
            <h3 class="figure-title">構成図</h3>
            <ZoomableImage src={project.diagram.image} alt={project.diagram.alt} />
          </div>
        )}
      </DetailArticle>
    ))
  }
</BaseLayout>

<style>
  .publications {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 12px;
  }

  .publication {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px;
  }

  .publication-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .publication-label {
    font-weight: 700;
  }

  .publication-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--accent);
  }

  .publication-link:hover,
  .publication-link:focus-visible {
    text-decoration: underline;
  }

  .publication-text {
    font-size: 14px;
    color: var(--ink-2);
  }

  /* 画像どうしの間を、題名と1枚目の間より広くあける */
  .figures {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .figures .figure-title {
    margin-bottom: -12px;
  }

  .figure-title {
    margin-bottom: 12px;
    font-size: 18px;
  }
</style>
