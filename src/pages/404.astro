---
// 存在しない URL を開いたときに CloudFront が返すページ。端末で存在しないディレクトリへ cd した画面に見立て、
// ls の結果として各ページへのリンクを並べる
import BaseLayout from '../layouts/BaseLayout.astro';
import { pages } from '../data/site';

const files = [
  { name: 'index.html', href: '/', label: pages.home.title },
  { name: 'portfolio.html', href: pages.projects.path, label: pages.projects.title },
  { name: 'toolbox.html', href: pages.tools.path, label: pages.tools.title },
  { name: 'diagram.html', href: pages.diagrams.path, label: pages.diagrams.title },
  { name: 'contact.html', href: pages.contact.path, label: pages.contact.title },
];
---

<BaseLayout page="notFound">
  <section class="not-found" aria-labelledby="hero-title">
    <p class="label">404 · Not found</p>
    <h1 id="hero-title">お探しのページは見つかりませんでした</h1>
    <p class="lead">{pages.notFound.description}</p>

    <div class="term" role="group" aria-label="端末風の表示">
      <p><span class="prompt">$</span> cd <span data-missing-path>/…</span></p>
      <p class="error">bash: cd: <span data-missing-path>/…</span>: No such file or directory</p>
      <p><span class="prompt">$</span> ls ~/termnix-it</p>
      <ul class="files">
        {
          files.map((file) => (
            <li>
              <a href={file.href}>
                {file.name}
                <span class="file-label">{file.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p><span class="prompt">$</span> <span class="cursor" aria-hidden="true"></span></p>
    </div>

    <a href="/" class="btn btn--primary btn--lg">ホームへ戻る</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    padding: clamp(48px, 8vw, 96px) 0 var(--section-space);
  }

  .not-found .label {
    margin-bottom: -12px;
  }

  h1 {
    font-size: clamp(26px, 4vw, 40px);
    line-height: 1.35;
  }

  .lead {
    max-width: 40em;
    color: var(--ink-2);
  }

  .term {
    width: 100%;
    max-width: 640px;
    padding: 18px 20px;
    border-radius: var(--radius-lg);
    background: var(--dark);
    color: var(--dark-ink);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.9;
    overflow-wrap: anywhere;
  }

  .prompt {
    color: #5dcaa5;
  }

  .error {
    color: #f79009;
  }

  .files {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(180px, 100%), 1fr));
    gap: 2px 16px;
    margin: 2px 0 6px;
  }

  .files a {
    display: flex;
    flex-direction: column;
    padding: 4px 0;
    color: #85b7eb;
  }

  .files a:hover {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .file-label {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--dot-neutral);
  }

  .cursor {
    display: inline-block;
    width: 8px;
    height: 1.1em;
    vertical-align: text-bottom;
    background: var(--dark-ink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .cursor {
      animation: cursor-blink 1s step-end infinite;
    }

    @keyframes cursor-blink {
      50% {
        opacity: 0;
      }
    }
  }
</style>

<script>
  // 開こうとした URL のパスを、cd の対象として表示する（JS が動かない場合は「/…」のまま）
  document.querySelectorAll('[data-missing-path]').forEach((element) => {
    element.textContent = window.location.pathname;
  });
</script>
