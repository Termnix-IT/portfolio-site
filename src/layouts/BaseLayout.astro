---
import '../styles/global.css';
import icon from '../assets/main-icon-192.png';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { pages, siteName, type PageKey } from '../data/site';

interface Props {
  page: PageKey;
}

const { page } = Astro.props;
const { title, description, path } = pages[page];
const fullTitle = `${title} | ${siteName}`;
const url = new URL(path, Astro.site).href;
// og:image は外部から長く参照されるため、版の付かない固定パス（public/static/img）に置いている
const ogImage = new URL('/static/img/main-icon.png', Astro.site).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- JS が動く環境でだけ、スクロールで現れる要素を最初に隠しておくための印 -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="1024" />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/png" href={icon.src} />
    <link rel="apple-touch-icon" href={icon.src} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+JP:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#content">本文へスキップ</a>
    <SiteHeader current={page} />
    <main id="content" class="container">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 10;
    padding: 8px 16px;
    border-radius: var(--radius);
    background: var(--ink);
    color: #ffffff;
    font-size: 14px;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
