---
// 状態を表す小さな札。ok=取得済・公開中・完成, warn=学習中・公開準備中, neutral=バージョンなどの補足
interface Props {
  tone?: 'ok' | 'warn' | 'neutral' | 'accent';
}

const { tone = 'neutral' } = Astro.props;
---

<span class:list={['badge', `badge--${tone}`]}><slot /></span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    padding: 1px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 500;
    line-height: 1.8;
    white-space: nowrap;
  }

  .badge--ok {
    background: var(--ok-bg);
    color: var(--ok-ink);
  }

  .badge--warn {
    background: var(--warn-bg);
    color: var(--warn-ink);
  }

  .badge--neutral {
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--ink-2);
    font-family: var(--font-mono);
  }

  .badge--accent {
    padding: 0 8px;
    background: var(--accent-tint);
    color: var(--accent);
    font-size: 11px;
  }
</style>
