---
import { Image } from 'astro:assets';
import avatar from '../assets/main-icon-192.png';
import Icon from './Icon.astro';
import { navItems, type PageKey } from '../data/site';

interface Props {
  current: PageKey;
}

const { current } = Astro.props;
---

<header class="site-header">
  <div class="container site-header-inner">
    <a href="/" class="brand" aria-current={current === 'home' ? 'page' : undefined}>
      <Image src={avatar} alt="" width={32} height={32} densities={[1, 2]} class="brand-icon" loading="eager" />
      Termnix-IT
    </a>
    <button
      class="menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="メニュー"
      data-nav-toggle
    >
      <span class="menu-open"><Icon name="menu" size={20} /></span>
      <span class="menu-close"><Icon name="close" size={20} /></span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="メイン">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', { 'nav-link--cta': item.key === 'contact' }]}
                aria-current={item.key === current ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    view-transition-name: site-header;
  }

  .site-header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 16px;
    min-height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .brand :global(.brand-icon) {
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    border-radius: 50%;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 14px;
  }

  .nav-link {
    position: relative;
    padding: 6px 0;
    color: var(--ink-2);
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--ink);
  }

  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
  }

  .nav-link--cta {
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--ink);
    color: #ffffff;
    font-weight: 500;
  }

  .nav-link--cta:hover,
  .nav-link--cta[aria-current='page'] {
    color: #ffffff;
  }

  .nav-link--cta[aria-current='page']::after {
    display: none;
  }

  .menu-button {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    cursor: pointer;
  }

  .menu-close {
    display: none;
  }

  @media (max-width: 720px) {
    .menu-button {
      display: inline-flex;
    }

    .site-nav {
      display: none;
      flex-basis: 100%;
      padding: 8px 0 16px;
    }

    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      font-size: 16px;
    }

    .nav-link {
      display: block;
      padding: 10px 4px;
    }

    .nav-link[aria-current='page']::after {
      right: auto;
      top: 10px;
      bottom: 10px;
      left: -10px;
      width: 2px;
      height: auto;
    }

    .nav-link--cta {
      margin-top: 8px;
      padding: 10px 16px;
      text-align: center;
    }

    .site-header.is-open .site-nav {
      display: block;
    }

    .site-header.is-open .menu-open {
      display: none;
    }

    .site-header.is-open .menu-close {
      display: inline-flex;
    }
  }
</style>

<script>
  // 狭い画面のメニュー開閉。ボタンの aria-expanded とヘッダーの .is-open を同時に切り替える
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const header = toggle?.closest('.site-header');

  toggle?.addEventListener('click', () => {
    const isOpen = header?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'メニューを閉じる' : 'メニュー');
  });
</script>
