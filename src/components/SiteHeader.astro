---
import { Image } from 'astro:assets';
import avatar from '../assets/main-icon-192.png';
import Icon from './Icon.astro';
import { navItems, type PageKey } from '../data/site';

interface Props {
  current: PageKey;
}

const { current } = Astro.props;
---

<header class="site-header">
  <div class="container site-header-inner">
    <a href="/" class="brand" aria-current={current === 'home' ? 'page' : undefined} data-egg-trigger>
      <Image src={avatar} alt="" width={32} height={32} densities={[1, 2]} class="brand-icon" loading="eager" />
      Termnix-IT
    </a>
    <button
      class="menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label="メニュー"
      data-nav-toggle
    >
      <span class="menu-open"><Icon name="menu" size={20} /></span>
      <span class="menu-close"><Icon name="close" size={20} /></span>
    </button>
    <nav id="site-nav" class="site-nav" aria-label="メイン">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav-link', { 'nav-link--cta': item.key === 'contact' }]}
                aria-current={item.key === current ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <!-- 隠しコマンド：ホームでロゴを続けて5回クリックすると、端末風の表示が出る -->
  <div class="egg" role="status" aria-live="polite" hidden data-egg>
    <div class="egg-head">
      <span class="egg-title">termnix-it ~ bash</span>
      <button type="button" class="egg-close" aria-label="閉じる" data-egg-close><Icon name="close" size={14} /></button>
    </div>
    <div class="egg-body" data-egg-body></div>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
    background: var(--surface);
    view-transition-name: site-header;
  }

  .site-header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 16px;
    min-height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.01em;
  }

  .brand :global(.brand-icon) {
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    border-radius: 50%;
  }

  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 28px;
    font-size: 14px;
  }

  .nav-link {
    position: relative;
    padding: 6px 0;
    color: var(--ink-2);
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--ink);
  }

  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
  }

  .nav-link--cta {
    padding: 8px 16px;
    border-radius: 999px;
    background: var(--ink);
    color: #ffffff;
    font-weight: 500;
  }

  .nav-link--cta:hover,
  .nav-link--cta[aria-current='page'] {
    color: #ffffff;
  }

  .nav-link--cta[aria-current='page']::after {
    display: none;
  }

  .menu-button {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    cursor: pointer;
  }

  .menu-close {
    display: none;
  }

  .egg {
    position: fixed;
    right: 16px;
    bottom: 16px;
    z-index: 20;
    width: min(420px, calc(100vw - 32px));
    overflow: hidden;
    border: 1px solid var(--dark-line);
    border-radius: var(--radius);
    background: var(--dark);
    color: var(--dark-ink);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.8;
  }

  .egg-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 6px 8px 6px 14px;
    border-bottom: 1px solid var(--dark-line);
    color: var(--dot-neutral);
  }

  .egg-close {
    display: inline-flex;
    width: 32px;
    height: 32px;
    align-items: center;
    justify-content: center;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .egg-close:hover {
    color: #ffffff;
  }

  .egg-body {
    min-height: 72px;
    padding: 10px 14px 12px;
    overflow-wrap: anywhere;
  }

  .egg-body :global(.egg-ok) {
    color: #5dcaa5;
  }

  .egg-body :global(a) {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .egg-body :global(a:hover) {
    color: #5dcaa5;
  }

  @media (prefers-reduced-motion: no-preference) {
    .egg:not([hidden]) {
      animation: egg-in 0.25s ease-out;
    }

    @keyframes egg-in {
      from {
        opacity: 0;
        transform: translateY(12px);
      }
    }
  }

  @media (max-width: 720px) {
    .menu-button {
      display: inline-flex;
    }

    .site-nav {
      display: none;
      flex-basis: 100%;
      padding: 8px 0 16px;
    }

    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      gap: 4px;
      font-size: 16px;
    }

    .nav-link {
      display: block;
      padding: 10px 4px;
    }

    .nav-link[aria-current='page']::after {
      right: auto;
      top: 10px;
      bottom: 10px;
      left: -10px;
      width: 2px;
      height: auto;
    }

    .nav-link--cta {
      margin-top: 8px;
      padding: 10px 16px;
      text-align: center;
    }

    .site-header.is-open .site-nav {
      display: block;
    }

    .site-header.is-open .menu-open {
      display: none;
    }

    .site-header.is-open .menu-close {
      display: inline-flex;
    }
  }
</style>

<script>
  // 狭い画面のメニュー開閉。ボタンの aria-expanded とヘッダーの .is-open を同時に切り替える
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const header = toggle?.closest('.site-header');

  toggle?.addEventListener('click', () => {
    const isOpen = header?.classList.toggle('is-open') ?? false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    toggle.setAttribute('aria-label', isOpen ? 'メニューを閉じる' : 'メニュー');
  });

  // 隠しコマンド。ホームにいるときだけロゴのクリックを数え（移動はせず先頭へ戻す）、
  // 2秒以内の間隔で5回続いたら端末風の表示に1行ずつ出す。
  // 遊び心つながりで、最後に趣味の作品置き場（Pirafu2411 Playground）へのリンクを添える
  const EGG_CLICKS = 5;
  const EGG_GAP_MS = 2000;
  const EGG_LINES: { text: string; ok?: boolean; link?: { href: string; label: string } }[] = [
    { text: '$ ping termnix-it.jp' },
    { text: '64 bytes from termnix-it.jp: icmp_seq=1 ttl=64 time=0.42 ms' },
    { text: '見つけてくれてありがとうございます', ok: true },
    { text: '$ cd ~/playground' },
    { text: '遊び心のある制作物は趣味の置き場にもあります → ', link: { href: 'https://pirafu2411.pages.dev/', label: 'Pirafu2411 Playground' } },
  ];

  const eggTrigger = document.querySelector<HTMLAnchorElement>('[data-egg-trigger][aria-current="page"]');
  const egg = document.querySelector<HTMLElement>('[data-egg]');
  const eggBody = egg?.querySelector<HTMLElement>('[data-egg-body]');
  let eggCount = 0;
  let eggLastClick = 0;
  let eggTimers: number[] = [];

  eggTrigger?.addEventListener('click', (event) => {
    event.preventDefault();
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });

    const now = Date.now();
    eggCount = now - eggLastClick <= EGG_GAP_MS ? eggCount + 1 : 1;
    eggLastClick = now;
    if (eggCount >= EGG_CLICKS) {
      eggCount = 0;
      showEgg(reduceMotion);
    }
  });

  egg?.querySelector('[data-egg-close]')?.addEventListener('click', hideEgg);

  function showEgg(reduceMotion: boolean) {
    if (!egg || !eggBody) {
      return;
    }

    hideEgg();
    egg.hidden = false;
    EGG_LINES.forEach((line, index) => {
      const timer = window.setTimeout(
        () => {
          const row = document.createElement('div');
          row.textContent = line.text;
          if (line.link) {
            const link = document.createElement('a');
            link.href = line.link.href;
            link.textContent = line.link.label;
            link.target = '_blank';
            link.rel = 'noopener noreferrer';
            row.append(link);
          }
          if (line.ok) {
            row.className = 'egg-ok';
          }
          eggBody.append(row);
        },
        reduceMotion ? 0 : index * 600,
      );
      eggTimers.push(timer);
    });
  }

  function hideEgg() {
    eggTimers.forEach((timer) => window.clearTimeout(timer));
    eggTimers = [];
    eggBody?.replaceChildren();
    if (egg) {
      egg.hidden = true;
    }
  }
</script>
