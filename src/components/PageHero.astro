---
// 各ページ冒頭の見出し。見出しの文言は slot で渡し、強調したい語を <mark> で囲む
import TagList from './TagList.astro';

interface Props {
  eyebrow: string;
  lead: string;
  tags?: string[];
  size?: 'xl' | 'lg';
}

const { eyebrow, lead, tags, size = 'lg' } = Astro.props;
---

<section class:list={['hero', `hero--${size}`]} aria-labelledby="hero-title">
  <p class="label hero-eyebrow">{eyebrow}</p>
  <h1 id="hero-title"><slot /></h1>
  <p class="hero-lead">{lead}</p>
  {tags && <div class="hero-tags"><TagList tags={tags} label="主な領域" /></div>}
  <slot name="after" />
</section>

<style>
  .hero {
    padding: clamp(48px, 7vw, 88px) 0 clamp(40px, 6vw, 72px);
  }

  .hero--xl {
    padding-top: clamp(56px, 9vw, 112px);
    padding-bottom: clamp(48px, 7vw, 88px);
  }

  .hero-eyebrow {
    margin-bottom: 16px;
    letter-spacing: 0.04em;
  }

  h1 {
    max-width: 880px;
    font-size: clamp(28px, 4.2vw, 46px);
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.01em;
    /* 日本語の見出しを文節で折り返し、「ア」だけが次の行に残るような改行を避ける */
    word-break: auto-phrase;
    text-wrap: balance;
  }

  .hero--xl h1 {
    font-size: clamp(30px, 5.2vw, 58px);
  }

  h1 :global(mark) {
    background: none;
    color: var(--accent);
  }

  .hero-lead {
    max-width: 40em;
    margin-top: 24px;
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.9;
    color: var(--ink-2);
  }

  .hero-tags {
    margin-top: 24px;
  }
</style>
