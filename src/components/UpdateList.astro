---
// ホームの更新履歴。新しい数件を並べ、残りは折りたたみ（<details>）にまとめる
import { formatDate, getUpdates, isoDate } from '../data/updates';

interface Props {
  visible?: number;
}

const { visible = 5 } = Astro.props;
const updates = (await getUpdates()).map((update) => ({
  ...update,
  label: formatDate(update.date),
  datetime: isoDate(update.date),
}));
const recent = updates.slice(0, visible);
const older = updates.slice(visible);
---

<ol class="updates">
  {
    recent.map((update) => (
      <li>
        <time class="mono" datetime={update.datetime}>{update.label}</time>
        {update.href ? <a href={update.href}>{update.text}</a> : <span>{update.text}</span>}
      </li>
    ))
  }
</ol>
{
  older.length > 0 && (
    <details class="older">
      <summary>それ以前の更新（{older.length}件）</summary>
      <ol class="updates">
        {older.map((update) => (
          <li>
            <time class="mono" datetime={update.datetime}>{update.label}</time>
            {update.href ? <a href={update.href}>{update.text}</a> : <span>{update.text}</span>}
          </li>
        ))}
      </ol>
    </details>
  )
}

<style>
  .updates li {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 24px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
  }

  time {
    flex: 0 0 96px;
    font-size: 13px;
    line-height: 1.8;
    color: var(--ink-3);
  }

  .updates a,
  .updates span {
    flex: 1 1 280px;
    min-width: 0;
  }

  .updates a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 4px;
  }

  .updates a:hover {
    color: var(--accent);
    text-decoration-color: currentColor;
  }

  .older summary {
    padding: 14px 0;
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
    cursor: pointer;
  }
</style>
