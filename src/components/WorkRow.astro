---
// ホームの「代表作」の1行。行全体が詳細へのリンクになる
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import TagList from './TagList.astro';

interface Props {
  href: string;
  meta: string;
  title: string;
  body: string;
  tags: string[];
  image?: { src: ImageMetadata; alt: string };
}

const { href, meta, title, body, tags, image } = Astro.props;
---

<li>
  <a href={href} class="card work-row">
    {
      image ? (
        <Image src={image.src} alt={image.alt} widths={[320, 640]} sizes="320px" class="work-media" />
      ) : (
        <span class="work-media work-media--text mono" aria-hidden="true">{title}</span>
      )
    }
    <div class="work-text">
      <span class="work-meta mono">{meta}</span>
      <span class="work-title">{title}</span>
      <span class="work-body">{body}</span>
      <TagList tags={tags} />
    </div>
    <span class="work-arrow"><Icon name="arrow-right" size={22} /></span>
  </a>
</li>

<style>
  .work-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 28px;
    padding: 20px;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  /* 乗せる・フォーカスすると、枠がアクセント色になり、題名に下線が走り、矢印が進む */
  .work-row:hover,
  .work-row:focus-visible {
    border-color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .work-row:hover,
    .work-row:focus-visible {
      transform: translateY(-3px);
    }
  }

  .work-row :global(.work-media) {
    flex: 1 1 240px;
    min-width: 0;
    max-width: 320px;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--ground);
  }

  .work-row .work-media--text {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    border-color: var(--dark);
    background: var(--dark);
    color: var(--dark-ink);
    font-size: 15px;
    text-align: center;
  }

  .work-text {
    display: flex;
    flex: 999 1 360px;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .work-meta {
    font-size: 12px;
    color: var(--ink-3);
  }

  .work-title {
    align-self: flex-start;
    font-size: 22px;
    line-height: 1.45;
    font-weight: 700;
    background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0% 2px no-repeat;
    transition: background-size 0.3s ease;
  }

  .work-row:hover .work-title,
  .work-row:focus-visible .work-title {
    background-size: 100% 2px;
  }

  .work-body {
    margin-bottom: 6px;
    font-size: 15px;
    color: var(--ink-2);
  }

  .work-arrow {
    flex: 0 0 auto;
    color: var(--dot-neutral);
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .work-row:hover .work-arrow,
  .work-row:focus-visible .work-arrow {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .work-row:hover .work-arrow,
    .work-row:focus-visible .work-arrow {
      transform: translateX(5px);
    }
  }

  @media (max-width: 560px) {
    .work-row :global(.work-media) {
      max-width: none;
    }

    .work-arrow {
      display: none;
    }
  }
</style>
